# Bu dosyayı Not Defteri ile aç, = işaretinden sonra kendi bilgilerini yapıştır ve kaydet.
# Bu dosyayı kimseyle paylaşma.

# Telegram'da @BotFather'ın verdiği token
TELEGRAM_TOKEN=

# Botu ilk açtığında /start yaz; bot sana numaranı söyleyecek, buraya yaz
IZINLI_KULLANICI_ID=

# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# elevenlabs.io > API anahtarı
ELEVENLABS_API_KEY=
# ElevenLabs > Voices > klonladığın sesin "Voice ID" değeri
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Videonun üstünde yazacak kanal adı
KANAL_ADI=Yorumları Okudum
